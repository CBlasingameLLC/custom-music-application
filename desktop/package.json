{
  "name": "musictoolkit-desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Desktop shell for Music Toolkit: starts the Python backend and shows its web UI in a native window.",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder --win --publish never",
    "test": "node --test"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cblasingame.musictoolkit",
    "productName": "Music Toolkit",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/mtk-backend.exe", "to": "mtk-backend.exe" },
      { "from": "resources/mtk-mtp", "to": "mtk-mtp" },
      { "from": "resources/mtk-disc", "to": "mtk-disc" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "fileAssociations": [
      { "ext": ["mp3"], "name": "MP3 audio", "description": "MP3 audio file", "role": "Viewer" },
      { "ext": ["flac"], "name": "FLAC audio", "description": "FLAC audio file", "role": "Viewer" },
      { "ext": ["m4a", "aac"], "name": "AAC audio", "description": "AAC audio file", "role": "Viewer" },
      { "ext": ["ogg", "oga", "opus"], "name": "Ogg audio", "description": "Ogg audio file", "role": "Viewer" },
      { "ext": ["wav"], "name": "WAV audio", "description": "WAV audio file", "role": "Viewer" }
    ],
    "publish": [
      { "provider": "github", "owner": "CBlasingameLLC", "repo": "custom-music-application", "releaseType": "release" }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Music Toolkit",
      "artifactName": "MusicToolkit-Setup-${version}.${ext}"
    }
  }
}
