# Copy to /etc/musictoolkit.env:   sudo install -m 0600 -o root -g root musictoolkit.env.example /etc/musictoolkit.env
# Anyone who has this token can use everything in the app (there are no accounts yet): keep the file readable by root only.
# Make one with:   openssl rand -hex 32
# Leave it empty (or do not install the file) and the server makes its own token in server.token next to config.toml.
MTK_TOKEN=
