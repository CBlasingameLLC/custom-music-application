__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Rooted (not bare) so these don't also swallow desktop/build/ (tracked —
# holds the app icon) or desktop's own dist-like output, which has its own
# nested .gitignore.
/build/
/dist/

# Runtime data — real user data, never commit
data/
logs/

# Real secrets/paths — commit config.example.toml instead
config.toml

.pytest_cache/
.DS_Store
Thumbs.db
.vscode/
.idea/
